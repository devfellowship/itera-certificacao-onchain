    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "index.js",
    "run-profile.js",
    "tool-environment.js",
    "model-catalog.js",
    "local-result.js",
    "trajectory.js",
    "pin.js",
    "run-artifacts.js",
    "compare.js",
    "index.d.ts",
    "model-catalog.d.ts",
    "compare.d.ts",
    "*.test.ts"
  ]
}

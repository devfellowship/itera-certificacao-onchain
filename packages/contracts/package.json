{
  "name": "@itera/contracts",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "description": "JSON Schemas (2020-12) of testmyagent contracts, their Ajv validators, and the model catalog (labs and routes).",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./tool-environment": {
      "types": "./index.d.ts",
      "default": "./tool-environment.js"
    },
    "./run-artifacts": {
      "types": "./index.d.ts",
      "default": "./run-artifacts.js"
    },
    "./model-catalog": {
      "types": "./model-catalog.d.ts",
      "default": "./model-catalog.js"
    },
    "./model-catalog/*": "./model-catalog/*",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}

{
  "$schema": "../../../../packages/contracts/schemas/task.schema.json",
  "schema_version": "1.0",
  "task": { "name": "itera-test/escape-probe", "version": "1", "description": "ADR-9 probe: hidden tests that try to reach the socket, the worker env, the network and the read-only workspace." },
  "instruction": "instruction.md",
  "environment": { "dir": "environment", "allow_internet": false },
  "tests": { "public": "tests/public", "hidden": "tests/hidden" },
  "solution": { "patch": "solution/solution.patch" },
  "editable_paths": ["src/**"],
  "protected_paths": ["tests/**", "package.json", "package-lock.json", "tsconfig.json", "vitest.config.*"],
  "verifier": { "cmd": ["npx", "vitest", "run", "{tests}", "--reporter=json", "--outputFile={report}"], "timeout_sec": 60 },
  "agent": { "timeout_sec": 60 },
  "est_minutes": 1
}

# /etc/dfl/model-routing.env  (host: openclaw-tainan / claude-main)
# One flag per model route. No secrets here.
# Read by: /root/.claude/skills/html-report/run.sh and
#          /root/.claude/skills/ui-design-compare/run.sh (env var wins over this file).
#
# DFL_ROUTE_HTML_REPORT
#   deepseek = zai-coding-plan/glm-5.3-flash, 2 attempts, then 1 Sonnet fallback (default)
#   sonnet   = skip opencode, 1 Sonnet attempt (rollback)
DFL_ROUTE_HTML_REPORT=deepseek

# DFL_ROUTE_UI_COMPARISON  (skill ui-design-compare: live app vs golden design, Pick C)
#   deepseek = zai-coding-plan/glm-5.3-flash, 2 attempts, then 1 Sonnet fallback (default)
#   sonnet   = skip opencode, 1 Sonnet attempt (rollback)
#   The HTML report of a comparison uses DFL_ROUTE_HTML_REPORT above.
DFL_ROUTE_UI_COMPARISON=deepseek
